# The edge image: TLS, ACME and reverse proxying only. Static files are served
# by the frontend image (#508).
#
# Keep nginx/Dockerfile as the legacy all-in-one image for Compose files written
# before the split. New installs use this image plus mikrotik-manager-frontend.
#
# Base images are pinned by digest; Dependabot updates them.
FROM nginx:alpine@sha256:713fc2ebfd92e8217db451477182ee91944b123d2b1ee9fd5a8c6e91ca6c3a11

# Certbot obtains and renews ACME certificates; su-exec runs it as the owner of
# the shared certificate volume. openssl generates the local fallback cert.
RUN apk add --no-cache certbot openssl su-exec

# Listeners and the edge app they serve (#256).
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/edge-app.conf /etc/nginx/mtm-app.conf

RUN rm -f /etc/nginx/conf.d/default.conf.bak

COPY nginx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/entrypoint.sh"]
